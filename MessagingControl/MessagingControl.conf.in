autostart = "@EXTN_MESSAGINGCONTROL_AUTOSTART@"

configuration = JSON()

if boolean("@EXTN_MESSAGINGCONTROL_CONSOLE@"):
  configuration.add("console", "@EXTN_MESSAGINGCONTROL_CONSOLE@")

if boolean("@EXTN_MESSAGINGCONTROL_SYSLOG@"):
  configuration.add("syslog", "@EXTN_MESSAGINGCONTROL_SYSLOG@")

if boolean("@EXTN_MESSAGINGCONTROL_FILENAME@"):
  configuration.add("filepath", "@EXTN_MESSAGINGCONTROL_FILENAME@")

if boolean("@EXTN_MESSAGINGCONTROL_ABBREVIATED@"):
  configuration.add("abbreviated", "@EXTN_MESSAGINGCONTROL_ABBREVIATED@")

configuration.add("maxexportconnections", "@EXTN_MESSAGINGCONTROL_MAX_EXPORTCONNECTIONS@")

if boolean("@EXTN_MESSAGINGCONTROL_REMOTE@"):
  remote = JSON()
  remote.add("port", "@EXTN_MESSAGINGCONTROL_PORT@")
  remote.add("binding", "@EXTN_MESSAGINGCONTROL_BINDING@")
  remote.add("interface", "@EXTN_MESSAGINGCONTROL_INTERFACE@")
  configuration.add("remote", remote)

if boolean("@EXTN_MESSAGINGCONTROL_TELEMETRY_T2@"):
  configuration.add("telemetryconfig", "@EXTN_MESSAGINGCONTROL_TELEMETRY_CONFIG@")
