autostart = "@EXT_MESSAGINGCONTROL_AUTOSTART@"

configuration = JSON()

if boolean("@EXT_MESSAGINGCONTROL_CONSOLE@"):
  configuration.add("console", "@EXT_MESSAGINGCONTROL_CONSOLE@")

if boolean("@EXT_MESSAGINGCONTROL_SYSLOG@"):
  configuration.add("syslog", "@EXT_MESSAGINGCONTROL_SYSLOG@")

if boolean("@EXT_MESSAGINGCONTROL_FILENAME@"):
  configuration.add("filepath", "@EXT_MESSAGINGCONTROL_FILENAME@")

if boolean("@EXT_MESSAGINGCONTROL_ABBREVIATED@"):
  configuration.add("abbreviated", "@EXT_MESSAGINGCONTROL_ABBREVIATED@")

configuration.add("maxexportconnections", "@EXT_MESSAGINGCONTROL_MAX_EXPORTCONNECTIONS@")

if boolean("@EXT_MESSAGINGCONTROL_REMOTE@"):
  remote = JSON()
  remote.add("port", "@EXT_MESSAGINGCONTROL_PORT@")
  remote.add("binding", "@EXT_MESSAGINGCONTROL_BINDING@")
  remote.add("interface", "@EXT_MESSAGINGCONTROL_INTERFACE@")
  configuration.add("remote", remote)

if boolean("@EXT_MESSAGINGCONTROL_TELEMETRY_T2@"):
  telemetry_config = JSON()
  telemetry_config.add("component", "@EXT_MESSAGINGCONTROL_TELEMETRY_COMPONENT@")
  configuration.add("telemetryconfig", telemetry_config)
