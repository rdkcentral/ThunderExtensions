startmode = "@EXT_PLUGININITIALIZERSERVICE_STARTMODE@"

if boolean("@EXT_PLUGININITIALIZERSERVICE_EXTENSION@"):
  extension = "@EXT_PLUGININITIALIZERSERVICE_EXTENSION@"

configuration = JSON()
if "@EXT_PLUGININITIALIZERSERVICE_MAXPARALLEL@":
    configuration.add("maxparallel", "@EXT_PLUGININITIALIZERSERVICE_MAXPARALLEL@")

configuration.add("maxretries", "@EXT_PLUGININITIALIZERSERVICE_DEFAULTMAXRETRIES@")
configuration.add("delay", "@EXT_PLUGININITIALIZERSERVICE_DEFAULTDELAY@")

